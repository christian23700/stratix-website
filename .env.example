# SMTP account used by the contact form (Nodemailer).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password as SMTP_PASS
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Where contact/support requests are delivered, and the From address.
CONTACT_TO=stratixdigitalsolution@gmail.com
# Perfume bookings (catalogue page). Optional: falls back to CONTACT_TO.
BOOKING_TO=
CONTACT_FROM="Stratix Website <your-smtp-user@gmail.com>"

# Public URL of the site (canonical links, hreflang, sitemap, link previews). On Vercel it defaults to the production URL.
NEXT_PUBLIC_SITE_URL=https://www.stratixdigitalsolutions.com
